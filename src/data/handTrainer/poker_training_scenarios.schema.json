{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/poker-training-scenarios.schema.json",
  "title": "Poker Training Scenario Pack",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "grading",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "feedback_mode": {
      "enum": [
        "end_of_hand"
      ]
    },
    "grading": {
      "type": "object",
      "required": [
        "excellent",
        "bon",
        "mauvais"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "format",
        "validation",
        "start_node_id",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "format": {
          "type": "object"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "enum": [
            "debutant",
            "intermediaire",
            "avance"
          ]
        },
        "validation": {
          "type": "object"
        },
        "start_node_id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "street",
        "state",
        "prompt",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "street": {
          "enum": [
            "preflop",
            "flop",
            "turn",
            "river"
          ]
        },
        "state": {
          "type": "object"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "action_type",
        "grade",
        "score",
        "is_optimal",
        "feedback"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "action_type": {
          "enum": [
            "fold",
            "check",
            "call",
            "limp",
            "bet",
            "raise",
            "shove"
          ]
        },
        "amount_bb": {
          "type": [
            "number",
            "null"
          ]
        },
        "grade": {
          "enum": [
            "excellent",
            "bon",
            "mauvais"
          ]
        },
        "score": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "is_optimal": {
          "type": "boolean"
        },
        "feedback": {
          "type": "string"
        },
        "ev_loss_bb": {
          "type": [
            "number",
            "null"
          ]
        },
        "next_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transition": {
          "type": [
            "object",
            "null"
          ]
        },
        "terminal": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}